# ============================================
# Kitchen Ledger - Environment Variables
# Copy to .env dan isi values yang diperlukan
# ============================================

# ------------------------------------------------------------------
# REQUIRED - Generate dengan: openssl rand -base64 32
# ------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-min-32-chars
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# ------------------------------------------------------------------
# REQUIRED - Frontend URL (untuk CORS & OAuth redirect)
# Production: https://yourdomain.com
# Development: http://localhost:5173
# ------------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------
# OPTIONAL - Google OAuth (untuk login Google)
# Dapatkan di: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${CLIENT_URL}/api/v1/auth/google/callback
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# DATABASE - Auto-configured di docker-compose
# Jika pakai external MongoDB, uncomment dan isi:
# ------------------------------------------------------------------
# MONGODB_URI=mongodb://username:password@host:27017/kitchen_ledger

# ------------------------------------------------------------------
# SERVER CONFIG
# ------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# JWT Expiry (default: 15m / 7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7