# Production Backend - Multi-stage build (root context with workspaces)
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root package files
COPY package*.json ./
COPY server/package*.json ./server/

# Install root + server deps
RUN npm ci --workspaces --omit=dev

# Copy server source
COPY server/src ./server/src

# Production image
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init tesseract-ocr tesseract-ocr-data-eng tesseract-ocr-data-ind
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
RUN mkdir -p /app/server/src/logs

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/server/src ./server/src
COPY --from=builder /app/server/package.json ./server/package.json

RUN chown -R nodejs:nodejs /app
USER nodejs

EXPOSE 5000
ENV NODE_ENV=production

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/src/server.js"]